<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <meta name="description" content="Smarthr - Bootstrap Admin Template">
    <meta name="keywords" content="admin, estimates, bootstrap, business, corporate, creative, management, minimal, modern, accounts, invoice, html5, responsive, CRM, Projects">
    <meta name="author" content="Dreamguys - Bootstrap Admin Template">
    <meta name="robots" content="noindex, nofollow">
    <title>@ViewData["Title"] - HRMS Jobs</title>

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/img/favicon.png")">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="@Url.Content("~/css/bootstrap.min.css")">
    
    <!-- Fontawesome CSS -->
    <link rel="stylesheet" href="@Url.Content("~/css/font-awesome.min.css")">
    
    <!-- Lineawesome CSS -->
    <link rel="stylesheet" href="@Url.Content("~/css/line-awesome.min.css")">
    
    <!-- Datatable CSS -->
    <link rel="stylesheet" href="@Url.Content("~/css/dataTables.bootstrap4.min.css")">
    
    <!-- Select2 CSS -->
    <link rel="stylesheet" href="@Url.Content("~/css/select2.min.css")">
    
    <!-- Datetimepicker CSS -->
    <link rel="stylesheet" href="@Url.Content("~/css/bootstrap-datetimepicker.min.css")">
    
    <!-- Main CSS -->
    <link rel="stylesheet" href="@Url.Content("~/css/style.css")">

    <!-- Toastr CSS -->
    <link rel="stylesheet" href="@Url.Content("~/css/toastr.min.css")">
    
    <script src="@Url.Content("~/js/toastr_jquery.min.js")"></script>
    <script src="@Url.Content("~/js/toastr.min.js")"></script>

    @RenderSection("Styles", required: false) <!-- Additional CSS Section -->
</head>
<body>
    <!-- Main Wrapper -->
    <div class="main-wrapper">
        @RenderBody()
    </div>
    <!-- /Main Wrapper -->

    <!-- jQuery -->
    <script src="@Url.Content("~/js/jquery-3.5.1.min.js")"></script>
    
    <!-- Bootstrap Core JS -->
    <script src="@Url.Content("~/js/popper.min.js")"></script>
    <script src="@Url.Content("~/js/bootstrap.min.js")"></script>
    
    <!-- Slimscroll JS -->
    <script src="@Url.Content("~/js/jquery.slimscroll.min.js")"></script>
    
    <!-- Select2 JS -->
    <script src="@Url.Content("~/js/select2.min.js")"></script>
    
    <!-- Datatable JS -->
    <script src="@Url.Content("~/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/js/dataTables.bootstrap4.min.js")"></script>
    
    <!-- Datetimepicker JS -->
    <script src="@Url.Content("~/js/moment.min.js")"></script>
    <script src="@Url.Content("~/js/bootstrap-datetimepicker.min.js")"></script>
    
    <!-- Custom JS -->
    <script src="@Url.Content("~/js/app.js")"></script>

    @RenderSection("Scripts", required: false) <!-- Additional JavaScript Section -->
</body>
</html>
