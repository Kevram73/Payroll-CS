@{
ViewData["Title"] = "Connexion Admin";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Connexion - Payroll System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        .input-group:focus-within label {
            color: #3b82f6;
        }
        .input-group:focus-within input {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }
    </style>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
<div class="w-full max-w-md bg-white shadow-xl rounded-lg p-8">
    <!-- Logo & Titre -->
    <div class="text-center">
        <i class="fas fa-user-shield text-blue-600 text-5xl"></i>
        <h2 class="text-3xl font-bold text-gray-800 mt-4">Espace Administrateur</h2>
        <p class="text-gray-500 mb-6">Connectez-vous pour accéder au tableau de bord</p>
    </div>

    <!-- Affichage des erreurs -->
    @if (!ViewData.ModelState.IsValid)
    {
    <div class="bg-red-100 text-red-600 p-3 rounded-lg mb-4">
        <i class="fas fa-exclamation-triangle"></i> Identifiants incorrects.
    </div>
    }

    <form asp-action="Login" method="post">
        <!-- Email -->
        <div class="mb-4">
            <label asp-for="Email" class="block text-sm font-medium text-gray-700">Email</label>
            <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                        <i class="fas fa-envelope text-gray-400"></i>
                    </span>
                <input asp-for="Email" type="email" required
                       class="pl-10 pr-3 py-2 w-full border rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none"
                       placeholder="admin@example.com" />
            </div>
        </div>

        <!-- Mot de passe -->
        <div class="mb-4">
            <label asp-for="Password" class="block text-sm font-medium text-gray-700">Mot de passe</label>
            <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3">
                        <i class="fas fa-lock text-gray-400"></i>
                    </span>
                <input asp-for="Password" type="password" required
                       class="pl-10 pr-3 py-2 w-full border rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none"
                       placeholder="••••••••" />
            </div>
        </div>

        <!-- Se souvenir de moi -->
        <div class="flex justify-between items-center mb-4">
            <label class="flex items-center">
                <input asp-for="RememberMe" type="checkbox" class="h-4 w-4 text-blue-600 border-gray-300 rounded">
                <span class="ml-2 text-sm text-gray-600">Se souvenir de moi</span>
            </label>
            <a href="#" class="text-sm text-blue-600 hover:underline">Mot de passe oublié ?</a>
        </div>

        <!-- Bouton Connexion -->
        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition duration-200">
            <i class="fas fa-sign-in-alt"></i> Connexion
        </button>
    </form>
</div>
</body>
</html>
