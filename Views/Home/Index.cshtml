@{
ViewData["Title"] = "Accueil";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil - Payroll System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        .hover-scale {
            transition: transform 0.3s ease-in-out;
        }
        .hover-scale:hover {
            transform: scale(1.05);
        }
        .gradient-bg {
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        }
        .gradient-bg-cta {
            background: linear-gradient(135deg, #3b82f6, #1e3a8a);
        }
        .animate-fade-in-down {
            animation: fadeInDown 0.8s ease-out;
        }
        .animate-fade-in-up {
            animation: fadeInUp 0.8s ease-out;
        }
    </style>
</head>
<body class="bg-gray-100">
<!-- Hero Section -->
<header class="gradient-bg text-white py-32 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 relative z-10">
        <h1 class="text-5xl font-bold animate-fade-in-down">Bienvenue sur Payroll System</h1>
        <p class="mt-4 text-xl text-blue-100 animate-fade-in-down delay-100">Une solution moderne pour gérer la paie et les employés.</p>
        <a asp-controller="Account" asp-action="Login" class="mt-8 inline-block bg-white text-blue-600 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-gray-100 transition duration-300 animate-fade-in-up delay-200">
            Connexion
        </a>
    </div>
    <img src="https://img.freepik.com/vecteurs-libre/gestion-paie-illustration-concept_114360-1485.jpg?w=1380&t=st=1715621237~exp=1715621837~hmac=5d8c0b5c8c5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5"
         alt="Illustration de gestion de paie"
         class="absolute bottom-0 right-0 w-1/3 opacity-50 transform translate-x-20 translate-y-10">
</header>

<!-- Features Section -->
<section class="container mx-auto px-6 py-20">
    <h2 class="text-4xl font-bold text-center text-gray-800 animate-fade-in-down">Pourquoi choisir notre solution ?</h2>
    <p class="mt-4 text-center text-gray-600 animate-fade-in-down delay-100">Découvrez les avantages de Payroll System</p>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-lg shadow-lg hover-scale">
            <img src="https://img.freepik.com/vecteurs-libre/gestion-employes-illustration-concept_114360-2581.jpg?w=1380&t=st=1715621364~exp=1715621964~hmac=5d8c0b5c8c5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5"
                 alt="Gestion des employés"
                 class="w-full h-48 object-cover rounded-lg">
            <div class="flex items-center justify-center w-16 h-16 bg-blue-100 text-blue-600 rounded-full mt-6">
                <i class="fas fa-user-tie text-2xl"></i>
            </div>
            <h3 class="mt-6 text-2xl font-semibold text-gray-800">Gestion des employés</h3>
            <p class="mt-4 text-gray-600">Ajoutez, mettez à jour et gérez facilement vos employés.</p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-lg hover-scale">
            <img src="https://img.freepik.com/vecteurs-libre/calcul-salaire-illustration-concept_114360-1486.jpg?w=1380&t=st=1715621404~exp=1715622004~hmac=5d8c0b5c8c5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5"
                 alt="Traitement de la paie"
                 class="w-full h-48 object-cover rounded-lg">
            <div class="flex items-center justify-center w-16 h-16 bg-green-100 text-green-600 rounded-full mt-6">
                <i class="fas fa-dollar-sign text-2xl"></i>
            </div>
            <h3 class="mt-6 text-2xl font-semibold text-gray-800">Traitement de la paie</h3>
            <p class="mt-4 text-gray-600">Automatisez le calcul des salaires et gérez les paiements.</p>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-lg hover-scale">
            <img src="https://img.freepik.com/vecteurs-libre/analyse-donnees-illustration-concept_114360-2582.jpg?w=1380&t=st=1715621434~exp=1715622034~hmac=5d8c0b5c8c5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5"
                 alt="Rapports et statistiques"
                 class="w-full h-48 object-cover rounded-lg">
            <div class="flex items-center justify-center w-16 h-16 bg-yellow-100 text-yellow-600 rounded-full mt-6">
                <i class="fas fa-chart-line text-2xl"></i>
            </div>
            <h3 class="mt-6 text-2xl font-semibold text-gray-800">Rapports et statistiques</h3>
            <p class="mt-4 text-gray-600">Obtenez des insights détaillés sur votre entreprise.</p>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="gradient-bg-cta text-white py-24 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 relative z-10">
        <h2 class="text-4xl font-bold animate-fade-in-down">Prêt à simplifier votre gestion de la paie ?</h2>
        <p class="mt-4 text-xl text-blue-100 animate-fade-in-down delay-100">Inscrivez-vous dès maintenant et gagnez du temps.</p>
        <a asp-controller="Account" asp-action="Login" class="mt-8 inline-block bg-white text-blue-600 font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-gray-100 transition duration-300 animate-fade-in-up delay-200">
            Commencer
        </a>
    </div>
    <img src="https://img.freepik.com/vecteurs-libre/equipe-gestion-paie-illustration-concept_114360-2583.jpg?w=1380&t=st=1715621464~exp=1715622064~hmac=5d8c0b5c8c5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5e5b5b5"
         alt="Équipe de gestion de paie"
         class="absolute bottom-0 left-0 w-1/3 opacity-50 transform -translate-x-20 translate-y-10">
</section>

<!-- Footer -->
<footer class="bg-gray-900 text-white text-center py-6">
    <p class="text-sm">&copy; @DateTime.Now.Year - Payroll System. Tous droits réservés.</p>
</footer>
</body>
</html>