@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<div class="">
    <div class="">
        <div class="page-header">
            <div class="row">
                <div class="col-sm-12">
                    <h3 class="page-title">Welcome @User.Identity.Name!</h3>
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- /Page Header -->

        <div class="row">
            <!-- Statistiques Principales -->
            <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                <div class="card dash-widget">
                    <div class="card-body">
                        <span class="dash-widget-icon"><i class="fa fa-cubes"></i></span>
                        <div class="dash-widget-info">
                            <h3>@ViewBag.TotalProjects</h3>
                            <span>Projects</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                <div class="card dash-widget">
                    <div class="card-body">
                        <span class="dash-widget-icon"><i class="fa fa-users"></i></span>
                        <div class="dash-widget-info">
                            <h3>@ViewBag.TotalClients</h3>
                            <span>Clients</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                <div class="card dash-widget">
                    <div class="card-body">
                        <span class="dash-widget-icon"><i class="fa fa-tasks"></i></span>
                        <div class="dash-widget-info">
                            <h3>@ViewBag.TotalTasks</h3>
                            <span>Tasks</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                <div class="card dash-widget">
                    <div class="card-body">
                        <span class="dash-widget-icon"><i class="fa fa-user"></i></span>
                        <div class="dash-widget-info">
                            <h3>@ViewBag.TotalEmployees</h3>
                            <span>Employees</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Graphiques -->
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-6 text-center">
                        <div class="card">
                            <div class="card-body">
                                <h3 class="card-title">Total Revenue</h3>
                                <div id="bar-charts"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 text-center">
                        <div class="card">
                            <div class="card-body">
                                <h3 class="card-title">Financial Overview</h3>
                                <div id="line-charts"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistiques Financières -->
        <div class="row">
            <div class="col-md-12">
                <div class="card-group m-b-30">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-3">
                                <div><span class="d-block">Total Revenue</span></div>
                            </div>
                            <h3>@ViewBag.TotalRevenue.ToString("C")</h3>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-3">
                                <div><span class="d-block">Total Expenses</span></div>
                            </div>
                            <h3>@ViewBag.TotalExpenses.ToString("C")</h3>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-3">
                                <div><span class="d-block">Net Profit</span></div>
                            </div>
                            <h3>@ViewBag.NetProfit.ToString("C")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistiques Détaillées -->
        <div class="row">
            <div class="col-md-12 col-lg-12 col-xl-4 d-flex">
                <div class="card flex-fill dash-statistics">
                    <div class="card-body">
                        <h5 class="card-title">System Statistics</h5>
                        <div class="stats-list">
                            <div class="stats-info">
                                <p>Departments <strong>@ViewBag.TotalDepartments</strong></p>
                                <div class="progress">
                                    <div class="progress-bar bg-primary" role="progressbar" 
                                         style="width: @(ViewBag.TotalDepartments)%"></div>
                                </div>
                            </div>
                            <div class="stats-info">
                                <p>Payrolls <strong>@ViewBag.TotalPayrolls</strong></p>
                                <div class="progress">
                                    <div class="progress-bar bg-warning" role="progressbar" 
                                         style="width: @(ViewBag.TotalPayrolls)%"></div>
                                </div>
                            </div>
                            <div class="stats-info">
                                <p>Invoices <strong>@ViewBag.TotalInvoices</strong></p>
                                <div class="progress">
                                    <div class="progress-bar bg-success" role="progressbar" 
                                         style="width: @(ViewBag.TotalInvoices)%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tableaux -->
            <div class="col-md-6 d-flex">
                <div class="card card-table flex-fill">
                    <div class="card-header">
                        <h3 class="card-title mb-0">Latest Invoices</h3>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-nowrap custom-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Total Invoices</th>
                                        <th>Total Amount</th>
                                        <th>Payment Methods</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@ViewBag.TotalInvoices</td>
                                        <td>@ViewBag.TotalPayments.ToString("C")</td>
                                        <td>@ViewBag.TotalPaymentMethods</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 d-flex">
                <div class="card card-table flex-fill">
                    <div class="card-header">
                        <h3 class="card-title mb-0">Employee Stats</h3>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table custom-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Benefits</th>
                                        <th>Deductions</th>
                                        <th>Attendance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@ViewBag.TotalBenefits</td>
                                        <td>@ViewBag.TotalDeductions</td>
                                        <td>@ViewBag.TotalAttendanceRecords</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section Utilisateurs -->
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">System Users</h4>
                        <div class="stats-info">
                            <p>Total Registered Users <strong>@ViewBag.TotalUsers</strong></p>
                            <div class="progress">
                                <div class="progress-bar bg-info" role="progressbar" 
                                     style="width: @(ViewBag.TotalUsers)%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Initialisation des graphiques
        document.addEventListener('DOMContentLoaded', function() {
            // Graphique à barres
            new Chart(document.getElementById('bar-charts'), {
                type: 'bar',
                data: {
                    labels: ['Revenue', 'Expenses', 'Profit'],
                    datasets: [{
                        label: 'Amount',
                        data: [
                            @ViewBag.TotalRevenue,
                            @ViewBag.TotalExpenses,
                            @ViewBag.NetProfit
                        ],
                        backgroundColor: ['#36a2eb', '#ff6384', '#4bc0c0']
                    }]
                }
            });

            // Graphique linéaire
            new Chart(document.getElementById('line-charts'), {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May'],
                    datasets: [{
                        label: 'Financial Flow',
                        data: [@ViewBag.TotalRevenue, @ViewBag.TotalExpenses, 
                              @ViewBag.NetProfit, 0, 0],
                        borderColor: '#4bc0c0'
                    }]
                }
            });
        });
    </script>
}