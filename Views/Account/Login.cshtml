@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-wrapper">
    <div class="account-content">
        <a href="@Url.Action("JobList", "Job")" class="btn btn-primary apply-btn">Apply Job</a>
        <div class="container">
            <!-- Account Logo -->
            <div class="account-logo">
                <a href="@Url.Action("Index", "Home")">
                    <img src="@Url.Content("~/img/logo2.png")" alt="Soeng Souy">
                </a>
            </div>
            <!-- Display Toastr Messages -->
            @await Html.PartialAsync("_ToastrMessages")

            <div class="account-box">
                <div class="account-wrapper">
                    <h3 class="account-title">Login</h3>
                    <p class="account-subtitle">Access to our dashboard</p>

                    <!-- Account Form -->
                    <form asp-action="Login" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" class="form-control @(ViewData["EmailError"] != null ? "is-invalid" : "")" name="Email" value="@ViewData["Email"]" placeholder="Enter email">
                            @if (ViewData["EmailError"] != null)
                            {
                                <span class="invalid-feedback" role="alert">
                                    <strong>@ViewData["EmailError"]</strong>
                                </span>
                            }
                        </div>

                        <div class="form-group">
                            <div class="row">
                                <div class="col">
                                    <label>Password</label>
                                </div>
                            </div>
                            <input type="password" class="form-control @(ViewData["PasswordError"] != null ? "is-invalid" : "")" name="Password" placeholder="Enter Password">
                            @if (ViewData["PasswordError"] != null)
                            {
                                <span class="invalid-feedback" role="alert">
                                    <strong>@ViewData["PasswordError"]</strong>
                                </span>
                            }
                        </div>

                        <div class="form-group">
                            <div class="row">
                                <div class="col-auto">
                                    <a class="text-muted" href="@Url.Action("ForgotPassword", "Account")">
                                        Forgot password?
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="form-group text-center">
                            <button class="btn btn-primary account-btn" type="submit">Login</button>
                        </div>

                        <div class="account-footer">
                            <p>Don't have an account yet? <a href="@Url.Action("Register", "Account")">Register</a></p>
                        </div>
                    </form>
                    <!-- /Account Form -->
                </div>
            </div>
        </div>
    </div>
</div>
