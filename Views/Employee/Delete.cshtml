@model Employee

@{
    ViewData["Title"] = "Supprimer l'Employé";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<div class="page-wrapper">
    <div class="content container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row">
                <div class="col-sm-12">
                    <h3 class="page-title">Supprimer l'Employé</h3>
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index">Employés</a></li>
                        <li class="breadcrumb-item active">Supprimer</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Carte Suppression -->
        <div class="card">
            <div class="card-body text-center">
                <i class="fa fa-exclamation-triangle text-warning fa-4x mb-3"></i>
                <h4 class="mb-4">Êtes-vous sûr de vouloir supprimer cet employé ?</h4>

                <!-- Affichage des détails de l'employé -->
                <div class="profile-img mb-3">
                    <img src="~/images/employees/@Model.Id" alt="@Model.FirstName @Model.LastName" class="rounded-circle" width="120">
                </div>
                <h5 class="font-weight-bold">@Model.FirstName @Model.LastName</h5>
                <p class="text-muted">@Model.Email - @Model.Phone</p>

                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mt-4">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa fa-trash"></i> Supprimer
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa fa-times"></i> Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
