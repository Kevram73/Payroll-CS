@model Employee

@{
ViewData["Title"] = "Détails de l'Employé";
Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<div class="page-wrapper">
    <div class="content container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="row">
                <div class="col-sm-12">
                    <h3 class="page-title">Détails de l'Employé</h3>
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index">Employés</a></li>
                        <li class="breadcrumb-item active">Détails</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Carte Profil -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="row">
                    <!-- Image de profil -->
                    <div class="col-md-3 text-center">
                        <div class="profile-img">
                            <img src="~/images/employees/@Model.Id" alt="@Model.FirstName @Model.LastName" class="rounded-circle" width="150">
                        </div>
                        <h4 class="mt-3">@Model.FirstName @Model.LastName</h4>
                        <p class="text-muted">@Model.Department?.Name</p>
                        <div class="mt-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fa fa-pencil-alt"></i> Modifier
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger" onclick="return confirm('Voulez-vous supprimer cet employé ?');">
                                <i class="fa fa-trash"></i> Supprimer
                            </a>
                        </div>
                    </div>

                    <!-- Infos personnelles -->
                    <div class="col-md-9">
                        <ul class="list-group">
                            <li class="list-group-item"><strong>Numéro ID :</strong> @Model.Id</li>
                            <li class="list-group-item"><strong>Email :</strong> @Model.Email</li>
                            <li class="list-group-item"><strong>Téléphone :</strong> @Model.Phone</li>
                            <li class="list-group-item"><strong>Date d'embauche :</strong> @Model.HireDate.ToString("dd/MM/yyyy")</li>
                            <li class="list-group-item"><strong>Département :</strong> @Model.Department?.Name</li>
                            <li class="list-group-item"><strong>Salaire :</strong> @(Model.SalaryStructure != null ? Model.SalaryStructure.BasicSalary + " €" : "Non défini")</li>
                            <li class="list-group-item"><strong>Méthode de paiement :</strong> @Model.PaymentMethod?.Type</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Autres Détails -->
        <div class="row">
            <!-- Statut Fiscal -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-success text-white">Informations Fiscales</div>
                    <div class="card-body">
                        <p><strong>Numéro Fiscal :</strong> @Model.TaxInformation?.TaxIdentificationNumber</p>
                        <p><strong>Réduction d'Impôt :</strong> @(Model.TaxInformation?.Exemptions != null ? Model.TaxInformation?.Exemptions + " %" : "Non défini")</p>
                    </div>
                </div>
            </div>

            <!-- Historique des Projets -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-info text-white">Projets Assignés</div>
                    <div class="card-body">
                        @if (Model.EmployeeProjects != null && Model.EmployeeProjects.Any())
                        {
                        <ul>
                            @foreach (var project in Model.EmployeeProjects)
                            {
                            <li>@project.Project.Name</li>
                            }
                        </ul>
                        }
                        else
                        {
                        <p>Aucun projet assigné.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
